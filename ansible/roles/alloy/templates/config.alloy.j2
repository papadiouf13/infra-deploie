// =====================================================================
// Grafana Alloy - collecte de journaux (format River).
// Genere par Ansible : environment/server injectes en labels externes.
// =====================================================================

// ---- Découverte des conteneurs Docker ----
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Enrichit chaque cible avec des labels lisibles (service, projet compose).
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }
}

// Acheminement commun vers Loki.
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = {
    environment = "{{ environment_name }}",
    server      = "{{ server_name }}",
  }
}

// ---- Logs des conteneurs Docker ----
loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.default.receiver]
}

// ---- Logs système (/var/log) ----
loki.source.file "system_logs" {
  targets    = [
    { "__path__" = "/var/log/syslog" },
    { "__path__" = "/var/log/auth.log" },
  ]
  forward_to = [loki.write.default.receiver]
}

// ---- Access logs Traefik (JSON) ----
loki.source.file "traefik_access" {
  targets    = [{ "__path__" = "/logs/traefik/access.log" }]
  forward_to = [loki.process.traefik.receiver]
}

loki.process "traefik" {
  stage.json {
    expressions = {
      status      = "DownstreamStatus",
      method      = "RequestMethod",
      duration_ms = "RequestDurationMs",
      router      = "RouterName",
      source      = "RemoteAddr",
      proto       = "RequestProtocol",
    }
  }
  forward_to = [loki.write.default.receiver]
}

// ---- Rapports de scan Trivy (JSONL, 1 ligne/image) ----
// Chaque ligne : {"ts","container","image","critical","high"}.
loki.source.file "trivy_reports" {
  targets    = [{ "__path__" = "/opt/trivy/reports/trivy.jsonl", source = "trivy" }]
  forward_to = [loki.write.default.receiver]
}