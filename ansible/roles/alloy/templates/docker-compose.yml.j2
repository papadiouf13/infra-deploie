# =====================================================================
# Grafana Alloy — réseau monitoring, socket Docker monté en lecture seule.
# =====================================================================
services:
  alloy:
    image: "{{ images.alloy }}"
    container_name: alloy
    restart: unless-stopped
    # Root requis : création du stockage /var/lib/alloy/data + lecture des
    # logs système (root:adm 640) — socket Docker et /var/log montés en ro.
    networks:
      - monitoring
    expose:
      - "12345"
    mem_limit: "{{ alloy_mem_limit }}"
    volumes:
      - ./config.alloy:/etc/alloy/config.alloy:ro
      # Socket Docker en lecture seule : découverte + lecture des logs.
      - /var/run/docker.sock:/var/run/docker.sock:ro
      # Logs système (syslog, auth) — lecture seule.
      - /var/log:/var/log:ro
      # Access logs de Traefik (format json) — lecture seule.
      # Hors de /var/log : runc ne peut pas créer le point de montage /
      # var/log/traefik à travers le bind ro /var/log (EROFS).
      - /opt/traefik/logs:/logs/traefik:ro
    command:
      - run
      - --server.http.listen-addr=0.0.0.0:12345
      - --storage.path=/var/lib/alloy/data
      - --stability.level=generally-available
      - /etc/alloy/config.alloy

networks:
  monitoring:
    external: true