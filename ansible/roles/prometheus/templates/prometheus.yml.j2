# =====================================================================
# Configuration Prometheus — générée par Ansible (idempotente).
# Labels globaux (environment, server) posés sur CHAQUE cible.
# =====================================================================
global:
  scrape_interval: {{ monitoring_scrape_interval }}
  evaluation_interval: {{ monitoring_scrape_interval }}

scrape_configs:
  # --- Santé de Prometheus lui-même ---
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
        labels:
          environment: "{{ environment_name }}"
          server: "{{ server_name }}"

  # --- Node Exporter (CPU, RAM, disque, réseau, I/O, load) ---
  - job_name: node_exporter
    static_configs:
      - targets: ["node-exporter:9100"]
        labels:
          environment: "{{ environment_name }}"
          server: "{{ server_name }}"

  # --- cAdvisor (métriques des conteneurs) ---
  - job_name: cadvisor
    static_configs:
      - targets: ["cadvisor:8080"]
        labels:
          environment: "{{ environment_name }}"
          server: "{{ server_name }}"

  # --- Traefik (requêtes, latence, erreurs, certs TLS) ---
  - job_name: traefik
    metrics_path: /metrics
    static_configs:
      - targets: ["traefik:8082"]
        labels:
          environment: "{{ environment_name }}"
          server: "{{ server_name }}"

  # --- Daemon Docker (metrics-addr 9323 configuré dans daemon.json) ---
  - job_name: docker
    scrape_interval: 30s
    static_configs:
      - targets: ["host.docker.internal:9323"]
        labels:
          environment: "{{ environment_name }}"
          server: "{{ server_name }}"

  # --- Grafana (santé) ---
  - job_name: grafana
    metrics_path: /metrics
    static_configs:
      - targets: ["grafana:3000"]
        labels:
          environment: "{{ environment_name }}"
          server: "{{ server_name }}"

  # --- Loki (ingestion, erreurs) ---
  - job_name: loki
    metrics_path: /metrics
    static_configs:
      - targets: ["loki:3100"]
        labels:
          environment: "{{ environment_name }}"
          server: "{{ server_name }}"

  # --- Grafana Alloy (lignes collectées, erreurs d'envoi) ---
  - job_name: alloy
    metrics_path: /metrics
    static_configs:
      - targets: ["alloy:12345"]
        labels:
          environment: "{{ environment_name }}"
          server: "{{ server_name }}"

  # --- Découverte automatique de conteneurs ---
  # Tout conteneur avec le label `prometheus.scrape=true` (+ optionnel
  # `prometheus.port` et `prometheus.path`) est scrapé automatiquement.
  - job_name: docker-containers
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        host_networking_host: host.docker.internal
    relabel_configs:
      - source_labels: [__meta_docker_container_label_prometheus_scrape]
        regex: "true"
        action: keep
      # Remplace le port du __address__ par celui du label prometheus.port.
      - source_labels: [__address__, __meta_docker_container_label_prometheus_port]
        regex: "(.*):(\\d+);(\\d+)"
        replacement: "${1}:${3}"
        action: replace
        target_label: __address__
      # Chemin des métriques : label prometheus.path (défaut /metrics).
      - source_labels: [__meta_docker_container_label_prometheus_path]
        regex: "(.+)"
        replacement: "${1}"
        action: replace
        target_label: __metrics_path__
      - target_label: environment
        replacement: "{{ environment_name }}"
      - target_label: server
        replacement: "{{ server_name }}"