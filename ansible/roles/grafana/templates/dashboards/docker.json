{
  "uid": "infra-docker",
  "title": "Docker",
  "description": "Métriques des conteneurs via cAdvisor et le daemon Docker",
  "tags": ["docker", "containers", "monitoring"],
  "timezone": "utc",
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environnement",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(up, environment)", "refId": "A" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "hide": 0,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "container",
        "label": "Conteneur",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(container_cpu_usage_seconds_total{environment=~\"$env\"}, name)", "refId": "A" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "hide": 0,
        "current": { "text": "All", "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 21,
      "type": "stat",
      "title": "Conteneurs en cours",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(container_cpu_usage_seconds_total{environment=~\"$env\"} == 0 or on (name) container_last_seen{name=~\"$container\"})", "legendFormat": "running", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 90 } ] } }, "overrides": [] }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Restarts (dernière 1h)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"$container\", environment=~\"$env\"}[1h]) * 0 + on (name) container_restart_count{name=~\"$container\"})", "legendFormat": "restarts", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "id": 23,
      "type": "table",
      "title": "Conteneurs — CPU / Mémoire / Réseau",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(sum(rate(container_cpu_usage_seconds_total{name=~\"$container\", environment=~\"$env\"}[5m])) by (name) * 100) / on (name) count(container_cpu_usage_seconds_total{name=~\"$container\"}) by (name)",
          "legendFormat": "cpu {{ name }}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "format": "table",
          "instant": true
        }
      ],
      "options": { "showHeader": true, "footer": { "show": false, "fields": "", "countRows": false } },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 90 } ] }, "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } }, "overrides": [] }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "CPU par conteneur (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "(sum(rate(container_cpu_usage_seconds_total{name=~\"$container\", environment=~\"$env\"}[5m])) by (name) * 100)", "legendFormat": "{{ name }}", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "intervalFactor": 1 }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "stacking": { "mode": "none" }, "showPoints": "never" } }, "overrides": [] },
      "interval": "30s"
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Mémoire par conteneur (Mo)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "container_memory_working_set_bytes{name=~\"$container\", environment=~\"$env\"} / 1024 / 1024", "legendFormat": "{{ name }}", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "intervalFactor": 1 }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "stacking": { "mode": "none" }, "showPoints": "never" } }, "overrides": [] },
      "interval": "30s"
    }
  ]
}