    {
      "id": 147,
      "type": "status-history",
      "title": "Conteneurs applicatifs",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_max(count by (name) (container_last_seen{name!=\"\", name=~\"$container\", name!~\"traefik|whoami|grafana|prometheus|loki|alloy|cadvisor|node-exporter|sonarqube|sonar-db|sonarqube-db\", environment=~\"$env\", server=~\"$server\"}), 1)",
          "legendFormat": "{{name}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "#F2495C",
                  "index": 1
                },
                "1": {
                  "text": "UP",
                  "color": "#73BF69",
                  "index": 0
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#73BF69"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.85,
        "colWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 148,
      "type": "bargauge",
      "title": "Taux de succès par router (5 min)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(1 - (sum by (router) (rate(traefik_router_requests_total{code=~\"5..\", router=~\"$router\", environment=~\"$env\", server=~\"$server\"}[5m])) or sum by (router) (rate(traefik_router_requests_total{router=~\"$router\", environment=~\"$env\", server=~\"$server\"}[5m])) * 0) / clamp_min(sum by (router) (rate(traefik_router_requests_total{router=~\"$router\", environment=~\"$env\", server=~\"$server\"}[5m])), 1e-9)) * 100",
          "legendFormat": "{{router}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 1,
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#F2495C"
              },
              {
                "value": 95,
                "color": "#FF9830"
              },
              {
                "value": 99,
                "color": "#73BF69"
              }
            ]
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "lcd",
        "valueMode": "color",
        "namePlacement": "auto",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "maxVizHeight": 300
      }
    },
