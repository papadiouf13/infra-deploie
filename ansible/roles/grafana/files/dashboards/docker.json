          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up, environment)",
          "refId": "A"
        },
        "definition": "label_values(up, environment)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "options": []
      },
      {
        "name": "server",
        "label": "Serveur",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{environment=~\"$env\"}, server)",
          "refId": "A"
        },
        "definition": "label_values(up{environment=~\"$env\"}, server)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
