          "expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\", name=~\"$container\", environment=~\"$env\", server=~\"$server\"}) / sum by (name) (container_spec_memory_limit_bytes{name!=\"\", container_spec_memory_limit_bytes < 1e15, name=~\"$container\", environment=~\"$env\", server=~\"$server\"}) * 100",
