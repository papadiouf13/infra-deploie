{
  "uid": "infra-docker",
  "title": "Docker",
  "description": "Métriques des conteneurs via cAdvisor et le daemon Docker",
  "tags": ["docker", "containers", "monitoring"],
  "timezone": "utc",
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 2,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environnement",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(up, environment)", "refId": "A" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "hide": 0,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "container",
        "label": "Conteneur",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(container_cpu_usage_seconds_total{environment=~\"$env\"}, name)", "refId": "A" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "hide": 0,
        "current": { "text": "All", "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 21,
      "type": "stat",
      "title": "Conteneurs en cours (running)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(container_last_seen{name=~\"$container\", environment=~\"$env\"})", "legendFormat": "running", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 90 } ] } }, "overrides": [] }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Démarrés (1h) / restarts",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(container_start_time_seconds{name=~\"$container\", environment=~\"$env\"} > (time() - 3600))", "legendFormat": "restarts", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "id": 28,
      "type": "stat",
      "title": "Top 5 CPU (actuel, %)",
      "gridPos": { "h": 8, "w": 6, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "topk(5, (sum(rate(container_cpu_usage_seconds_total{name=~\"$container\", environment=~\"$env\", id!=\"/\"}[5m])) by (name)) * 100)", "legendFormat": "{{ name }}", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "instant": true, "format": "table" }
      ],
      "options": { "showHeader": true, "sortBy": [{ "displayName": null, "desc": true }] },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 90 } ] }, "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } }, "overrides": [] }
    },
    {
      "id": 29,
      "type": "stat",
      "title": "Top 5 RAM (actuel, Mo)",
      "gridPos": { "h": 8, "w": 6, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "topk(5, (container_memory_working_set_bytes{name=~\"$container\", environment=~\"$env\", id!=\"/\"} / 1024 / 1024))", "legendFormat": "{{ name }}", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "instant": true, "format": "table" }
      ],
      "options": { "showHeader": true, "sortBy": [{ "displayName": null, "desc": true }] },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 90 } ] }, "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } }, "overrides": [] }
    },
    {
      "id": 26,
      "type": "stat",
      "title": "Limite mémoire (total, Go)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(container_spec_memory_limit_bytes{name=~\"$container\", environment=~\"$env\", id!=\"/\"}) / 1024 / 1024 / 1024", "legendFormat": "limit", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "decgbytes", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 90 } ] } }, "overrides": [] }
    },
    {
      "id": 23,
      "type": "table",
      "title": "Conteneurs — CPU / Mémoire / Limite",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(sum(rate(container_cpu_usage_seconds_total{name=~\"$container\", environment=~\"$env\", id!=\"/\"}[5m])) by (name) * 100)",
          "legendFormat": "cpu {{ name }}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "format": "table",
          "instant": true
        },
        {
          "expr": "container_memory_working_set_bytes{name=~\"$container\", environment=~\"$env\", id!=\"/\"} / 1024 / 1024",
          "legendFormat": "mem {{ name }}",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "format": "table",
          "instant": true
        },
        {
          "expr": "container_spec_memory_limit_bytes{name=~\"$container\", environment=~\"$env\", id!=\"/\"} / 1024 / 1024",
          "legendFormat": "limit {{ name }}",
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "format": "table",
          "instant": true
        }
      ],
      "options": { "showHeader": true, "footer": { "show": false, "fields": "", "countRows": false } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 90 } ] }, "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } }, "overrides": [] }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "CPU par conteneur (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "(sum(rate(container_cpu_usage_seconds_total{name=~\"$container\", environment=~\"$env\", id!=\"/\"}[5m])) by (name) * 100)", "legendFormat": "{{ name }}", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "intervalFactor": 1 }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "stacking": { "mode": "none" }, "showPoints": "never" } }, "overrides": [] },
      "interval": "30s"
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Mémoire par conteneur (Mo)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "container_memory_working_set_bytes{name=~\"$container\", environment=~\"$env\", id!=\"/\"} / 1024 / 1024", "legendFormat": "{{ name }}", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "intervalFactor": 1 }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "stacking": { "mode": "none" }, "showPoints": "never" } }, "overrides": [] },
      "interval": "30s"
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Réseau par conteneur (Mo/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"$container\", environment=~\"$env\"}[5m])) / 1024 / 1024", "legendFormat": "rx {{ name }}", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "intervalFactor": 1 },
        { "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\"$container\", environment=~\"$env\"}[5m])) / 1024 / 1024", "legendFormat": "tx {{ name }}", "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "intervalFactor": 1 }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "stacking": { "mode": "none" }, "showPoints": "never" } }, "overrides": [] },
      "interval": "30s"
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "I/O disque par conteneur (Mo/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (name) (rate(container_fs_reads_bytes_total{name=~\"$container\", environment=~\"$env\"}[5m])) / 1024 / 1024", "legendFormat": "read {{ name }}", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "intervalFactor": 1 },
        { "expr": "sum by (name) (rate(container_fs_writes_bytes_total{name=~\"$container\", environment=~\"$env\"}[5m])) / 1024 / 1024", "legendFormat": "write {{ name }}", "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "intervalFactor": 1 }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "stacking": { "mode": "none" }, "showPoints": "never" } }, "overrides": [] },
      "interval": "30s"
    }
  ]
}
