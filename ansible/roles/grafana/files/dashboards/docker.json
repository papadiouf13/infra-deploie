    {
      "id": 69,
      "type": "bargauge",
      "title": "Mémoire utilisée / limite (%)",
      "description": "Seulement les conteneurs avec mem_limit défini.",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
