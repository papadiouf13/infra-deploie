# =====================================================================
# SonarQube + PostgreSQL.
# sonar-db : réseau interne dedicé (jamais exposé).
# sonarqube : réseaux proxy (Traefik) + sonar-net (Base de données).
# =====================================================================
services:
  sonar-db:
    image: "{{ images.postgres }}"
    container_name: sonar-db
    restart: unless-stopped
    networks:
      - sonar-net
    environment:
      POSTGRES_USER: sonar
      POSTGRES_PASSWORD: "{{ sonarqube_db_password }}"
      POSTGRES_DB: sonarqube
    volumes:
      - ./db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U sonar -d sonarqube"]
      interval: 10s
      timeout: 5s
      retries: 10

  sonarqube:
    image: "{{ images.sonarqube }}"
    container_name: sonarqube
    restart: unless-stopped
    depends_on:
      sonar-db:
        condition: service_healthy
    networks:
      - proxy
      - sonar-net
    expose:
      - "{{ sonarqube_web_port }}"
    mem_limit: "{{ sonarqube_mem_limit }}"
    cpus: "{{ sonarqube_cpu_limit }}"
    environment:
      SONAR_JDBC_URL: "jdbc:postgresql://sonar-db:5432/sonarqube"
      SONAR_JDBC_USERNAME: sonar
      SONAR_JDBC_PASSWORD: "{{ sonarqube_db_password }}"
      # Mémoires volontairement serrées (instance 4 Go).
      SONAR_SEARCH_JAVAOPTS: "-Xms512m -Xmx512m"
      SONAR_WEB_JAVAOPTS: "-Xmx768m -Xms256m"
      SONAR_CE_JAVAOPTS: "-Xmx768m -Xms256m"
    volumes:
      - ./data:/opt/sonarqube/data
      - ./logs:/opt/sonarqube/logs
      - ./extensions:/opt/sonarqube/extensions
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.sonar.rule=Host(`{{ sonar_host }}`)"
      - "traefik.http.routers.sonar.entrypoints=websecure"
      - "traefik.http.routers.sonar.service=sonar"
{% if traefik_cert_type == 'letsencrypt' %}
      - "traefik.http.routers.sonar.tls.certresolver=letsencrypt"
{% endif %}
      - "traefik.http.services.sonar.loadbalancer.server.port={{ sonarqube_web_port }}"

networks:
  proxy:
    external: true
  sonar-net:
    driver: bridge